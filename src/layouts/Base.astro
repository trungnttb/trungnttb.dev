---
import '../styles/global.css';
import { profile } from '../data/profile';
import { locale, t } from '../i18n';
import { clipText, pageTitle as buildPageTitle } from '../seo/text';

interface Props {
  title?: string;
  description?: string;
  /** Site-relative path of the Open Graph image; defaults to the site card. */
  ogImage?: string;
  /** Set on post/note pages: marks the page as an article for link previews. */
  article?: { published: Date; tags: string[] };
  /** Schema.org JSON-LD object(s) describing the page for search engines. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description: fullDescription = t('meta.description'), ogImage = '/og/site.png', article, jsonLd } = Astro.props;
const pageTitle = buildPageTitle(title, profile.siteTitle);
const description = clipText(fullDescription);
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(ogImage, Astro.site);
// Inline JSON must not be able to close its <script> tag.
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replaceAll('<', '\\u003c') : undefined;
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1110" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={profile.domain} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title ?? profile.siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? profile.siteTitle} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article && <meta property="article:author" content={profile.name} />}
    {article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? profile.siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
