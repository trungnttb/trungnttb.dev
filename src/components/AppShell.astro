---
import { getCollection } from 'astro:content';
import type { CollectionName, EntrySummary } from '../app/entries';
import { t } from '../i18n';

interface Props {
  /** Set on detail pages: the entry rendered into the finder's slot. */
  entry?: { collection: CollectionName; id: string };
}

const { entry } = Astro.props;

const visible = ({ data }: { data: { draft: boolean } }) => import.meta.env.DEV || !data.draft;
const posts = await getCollection('posts', visible);
const notes = await getCollection('notes', visible);

const summaries: EntrySummary[] = [
  ...posts.map((p) => ({
    collection: 'posts' as const,
    id: p.id,
    title: p.data.title,
    summary: p.data.summary,
    date: p.data.date.toISOString(),
    tags: p.data.tags,
  })),
  ...notes.map((n) => ({
    collection: 'notes' as const,
    id: n.id,
    title: n.data.title,
    summary: n.data.description,
    date: n.data.date.toISOString(),
    tags: n.data.tags,
    lang: n.data.lang,
  })),
].sort((a, b) => b.date.localeCompare(a.date));

// Inline JSON must not be able to close its <script> tag.
const entriesJson = JSON.stringify(summaries).replaceAll('<', '\\u003c');
---

<div
  id="app"
  data-mode={entry ? 'cli' : 'scene'}
  data-entry-collection={entry?.collection}
  data-entry-id={entry?.id}
  class="fixed inset-0"
>
  <div id="scene" class="fixed inset-0" aria-hidden="true"></div>

  <p id="scene-loading" class="pointer-events-none fixed inset-x-0 top-6 text-center text-sm text-latte" hidden>
    {t('scene.loading')}
  </p>

  <div id="time-control" class="fixed top-4 right-4 flex items-center gap-2">
    <button
      id="clock-auto"
      type="button"
      class="rounded-full border border-coffee-700 bg-coffee-950/65 px-3 py-1.5 text-xs text-foam backdrop-blur-sm hover:bg-coffee-800 focus-visible:outline-2 focus-visible:outline-crema aria-pressed:border-crema aria-pressed:text-crema"
      aria-pressed="true"
      title={t('clock.autoLabel')}>{t('clock.auto')}</button>
    <button
      id="clock"
      type="button"
      class="flex items-center gap-2 rounded-full border border-coffee-700 bg-coffee-950/65 py-1 pr-3 pl-1 text-xs text-foam backdrop-blur-sm hover:bg-coffee-800 focus-visible:outline-2 focus-visible:outline-crema"
      aria-label={t('clock.label')}
      title={t('clock.label')}
    >
      <svg class="h-8 w-8" viewBox="0 0 32 32" aria-hidden="true">
        <circle cx="16" cy="16" r="14" fill="var(--color-foam)" stroke="var(--color-coffee-600)" stroke-width="2"></circle>
        {Array.from({ length: 12 }, (_, i) => (
          <line x1="16" y1="4" x2="16" y2={i % 3 === 0 ? 7 : 5.5} stroke="var(--color-coffee-600)" stroke-width="1.2" transform={`rotate(${i * 30} 16 16)`}></line>
        ))}
        <line id="clock-hour" x1="16" y1="16" x2="16" y2="9.5" stroke="var(--color-coffee-950)" stroke-width="2.4" stroke-linecap="round"></line>
        <line id="clock-minute" x1="16" y1="16" x2="16" y2="6" stroke="var(--color-crema)" stroke-width="1.6" stroke-linecap="round"></line>
        <circle cx="16" cy="16" r="1.4" fill="var(--color-coffee-950)"></circle>
      </svg>
      <span id="clock-label" class="tabular-nums"></span>
    </button>
  </div>

  <div
    id="scene-hint"
    class="pointer-events-none fixed bottom-8 left-1/2 flex -translate-x-1/2 flex-col items-center gap-0.5 rounded-2xl bg-coffee-950/65 px-5 py-2.5 text-sm text-foam backdrop-blur-sm"
  >
    <span>
      <span class="hint-fine">{t('scene.hint.scroll')}</span><span class="hint-touch">{t('scene.hint.swipe')}</span>
    </span>
    <span class="flex items-center gap-2 opacity-90">
      {t('scene.hint.key')}
      <button id="hint-key" type="button" class="keycap pointer-events-auto" aria-label={t('toggle.label')} title={t('toggle.label')}>`</button>
    </span>
    <svg class="mt-1 h-5 w-5 animate-bounce" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M6 9l6 6 6-6"></path>
    </svg>
  </div>

  <section id="cli" class="fixed inset-0 flex flex-col bg-coffee-950 text-[0.9rem] sm:text-[0.95rem]" aria-label={t('cli.inputLabel')}>
    <nav
      id="cli-commands"
      class="flex flex-wrap gap-2 border-b border-coffee-800 bg-coffee-900 px-4 py-2.5 pr-16 sm:px-6"
      aria-label={t('cli.commandsLabel')}
    >
    </nav>
    <div id="cli-scroll" class="flex-1 overflow-y-auto px-4 py-4 sm:px-6">
      <div id="cli-output" role="log" aria-live="polite"></div>
      <form id="cli-form" class="mt-3 flex items-baseline gap-[1ch]" autocomplete="off">
        <label for="cli-input" class="cli-prompt shrink-0">{t('cli.prompt')}</label>
        <input
          id="cli-input"
          class="min-w-0 flex-1 bg-transparent text-foam caret-crema outline-none"
          type="text"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          enterkeyhint="go"
          aria-label={t('cli.inputLabel')}
        />
      </form>
    </div>
  </section>

  <div
    id="finder"
    class="fixed inset-0 z-10 flex bg-coffee-950/70 p-0 backdrop-blur-sm sm:p-6 data-maximized:sm:p-0"
    role="dialog"
    aria-modal="true"
    aria-labelledby="finder-title"
    hidden={!entry}
  >
    <div class="finder-window flex min-h-0 flex-1 flex-col overflow-hidden border-coffee-700 bg-coffee-900 shadow-2xl sm:rounded-xl sm:border">
      <header class="flex items-center gap-3 border-b border-coffee-700 bg-coffee-850 px-4 py-2.5">
        <div class="traffic-lights flex items-center gap-2">
          <button id="finder-close" type="button" class="traffic traffic-close" aria-label={t('finder.close')} title={t('finder.close')}>
            <svg viewBox="0 0 10 10" aria-hidden="true"><path d="M2.5 2.5l5 5M7.5 2.5l-5 5"></path></svg>
          </button>
          <span class="traffic traffic-idle" aria-hidden="true"></span>
          <button id="finder-maximize" type="button" class="traffic traffic-maximize" aria-label={t('finder.maximize')} title={t('finder.maximize')} aria-pressed="false">
            <svg viewBox="0 0 10 10" aria-hidden="true"><path d="M5 2v6M2 5h6"></path></svg>
          </button>
        </div>
        <h2 id="finder-title" class="shrink-0 font-bold text-foam">
          {entry ? t(`finder.title.${entry.collection}`) : ''}
        </h2>
        <input
          id="finder-search"
          type="search"
          class="ml-auto w-full max-w-xs rounded-md border border-coffee-700 bg-coffee-950 px-3 py-1 text-sm text-foam placeholder:text-coffee-600 focus:border-crema focus:outline-none"
          autocomplete="off"
          spellcheck="false"
          hidden={!!entry}
        />
        <button
          id="finder-back"
          type="button"
          class="ml-auto flex items-center gap-2 rounded-lg border border-coffee-600 bg-coffee-800 px-4 py-1.5 text-sm text-crema hover:border-crema hover:bg-coffee-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-crema"
          hidden={!entry}
        >
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M10 3L5 8l5 5"></path></svg>
          <span>{t('finder.back')}</span>
          <kbd class="hidden rounded border border-coffee-600 px-1.5 text-[0.7rem] text-latte sm:inline">Esc</kbd>
        </button>
      </header>

      <div id="finder-list-view" class="flex min-h-0 flex-1 flex-col" hidden={!!entry}>
        <div class="finder-head border-b border-coffee-700 text-xs text-latte" aria-hidden="true">
          <span>{t('finder.col.name')}</span>
          <span>{t('finder.col.date')}</span>
          <span class="finder-tags">{t('finder.col.tags')}</span>
        </div>
        <ul id="finder-rows" class="flex-1 overflow-y-auto p-2" role="listbox" aria-labelledby="finder-title"></ul>
        <p id="finder-count" class="border-t border-coffee-700 px-4 py-1.5 text-center text-xs text-latte"></p>
      </div>

      <div id="finder-detail-view" class="min-h-0 flex-1 overflow-y-auto" hidden={!entry}>
        <div id="finder-detail"><slot /></div>
      </div>
    </div>
  </div>

  <button
    id="toggle"
    type="button"
    class="keycap keycap-lg fixed right-4 bottom-4 z-20"
    aria-label={t('toggle.label')}
    title={t('toggle.label')}>`</button>
</div>

<script id="entries-data" type="application/json" set:html={entriesJson} />

<script>
  import { boot } from '../app/main';
  boot();
</script>
