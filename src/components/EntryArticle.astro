---
import type { MarkdownHeading } from 'astro';
import { locale, t } from '../i18n';

interface Props {
  title: string;
  date: Date;
  tags: string[];
  lang?: string;
  headings?: MarkdownHeading[];
}

/** Below this many sections a table of contents is noise. */
const TOC_MIN_SECTIONS = 3;

const { title, date, tags, lang, headings = [] } = Astro.props;
const formatted = new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'long', day: 'numeric' }).format(date);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const shareTargets = [
  { network: 'X', href: `https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(title)}` },
  { network: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}` },
  { network: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}` },
];
const tocItems = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const hasToc = headings.filter((heading) => heading.depth === 2).length >= TOC_MIN_SECTIONS;
---

<article class:list={['entry', { 'entry-with-toc': hasToc }]} data-entry-article>
  <header class="entry-header">
    <h1 class="entry-title">{title}</h1>
    <p class="entry-meta">
      <time datetime={date.toISOString()}>{formatted}</time>
      {lang && <span>{lang}</span>}
      {tags.length > 0 && <span>{tags.map((tag) => `#${tag}`).join(' ')}</span>}
    </p>
    <div class="entry-share" data-share-url={pageUrl} data-share-title={title}>
      <button type="button" class="share-button" data-share-native hidden>{t('share.label')}</button>
      <button type="button" class="share-button" data-share-copy>{t('share.copy')}</button>
      {
        shareTargets.map(({ network, href }) => (
          <a class="share-button" href={href} target="_blank" rel="noopener noreferrer" aria-label={t('share.on', { network })}>
            {network}
          </a>
        ))
      }
    </div>
  </header>
  {
    hasToc && (
      <details class="entry-toc-compact">
        <summary>{t('entry.toc')}</summary>
        <nav data-toc>
          <ol>
            {tocItems.map((h) => (
              <li class={`toc-depth-${h.depth}`}>
                <a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    )
  }
  <div class="entry-body">
    <slot />
  </div>
  {
    hasToc && (
      <aside class="entry-toc" aria-label={t('entry.toc')}>
        <p class="entry-toc-title">{t('entry.toc')}</p>
        <nav data-toc>
          <ol>
            {tocItems.map((h) => (
              <li class={`toc-depth-${h.depth}`}>
                <a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>
    )
  }
</article>
