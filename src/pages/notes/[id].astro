---
import { getCollection, render } from 'astro:content';
import AppShell from '../../components/AppShell.astro';
import EntryArticle from '../../components/EntryArticle.astro';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const entries = await getCollection('notes', ({ data }) => import.meta.env.DEV || !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <AppShell entry={{ collection: 'notes', id: entry.id }}>
    <EntryArticle title={entry.data.title} date={entry.data.date} tags={entry.data.tags} headings={headings} lang={entry.data.lang}>
      <Content />
    </EntryArticle>
  </AppShell>
</Base>
