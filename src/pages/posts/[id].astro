---
import { getCollection, render } from 'astro:content';
import AppShell from '../../components/AppShell.astro';
import EntryArticle from '../../components/EntryArticle.astro';
import Base from '../../layouts/Base.astro';
import { entrySchema } from '../../seo/schema';

export async function getStaticPaths() {
  const entries = await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const ogImage = `/og/posts/${entry.id}.png`;
const jsonLd = entrySchema({
  kind: 'posts',
  url: new URL(Astro.url.pathname, Astro.site).href,
  title: entry.data.title,
  description: entry.data.summary,
  published: entry.data.date,
  tags: entry.data.tags,
  image: new URL(ogImage, Astro.site).href,
});
---

<Base title={entry.data.title} description={entry.data.summary} ogImage={ogImage} jsonLd={jsonLd} article={{ published: entry.data.date, tags: entry.data.tags }}>
  <AppShell entry={{ collection: 'posts', id: entry.id }}>
    <EntryArticle title={entry.data.title} date={entry.data.date} tags={entry.data.tags} headings={headings}>
      <Content />
    </EntryArticle>
  </AppShell>
</Base>
